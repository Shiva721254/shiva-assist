<Window x:Class="ShivaAssist.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Product}" Width="1060" Height="780" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Page}"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}">
  <Window.Resources>
    <!-- One finding card: layer 1 always, layers 2-3 under Details. Used on the overview and on every module page. -->
    <DataTemplate x:Key="FindingCard">
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,10">
        <DockPanel>
          <Border DockPanel.Dock="Left" Width="5" Background="{Binding Accent}" CornerRadius="12,0,0,12" />
          <StackPanel Margin="16,12,16,12">
            <DockPanel>
              <Border DockPanel.Dock="Left" Background="{Binding Accent}" CornerRadius="10" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
              </Border>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Text="{Binding Advice, StringFormat='→ {0}'}" Visibility="{Binding HasAdvice, Converter={StaticResource Visible}}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding Repairs}" Visibility="{Binding HasRepairs, Converter={StaticResource Visible}}" Margin="0,10,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource QuietButton}" Content="{Binding Label}" ToolTip="{Binding Tooltip}"
                          Command="{Binding Command}" Margin="0,0,8,6" Padding="12,5" FontSize="13" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Outcome}" Visibility="{Binding HasOutcome, Converter={StaticResource Visible}}"
                       Foreground="{Binding OutcomeColour}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
            <Expander IsExpanded="{Binding Expanded}" Margin="0,8,0,0" Foreground="{StaticResource Green}"
                      Header="{Binding DataContext.TextDetails, RelativeSource={RelativeSource AncestorType=Window}}">
              <StackPanel Margin="20,6,0,0">
                <TextBlock Text="{Binding Cause}" Visibility="{Binding HasCause, Converter={StaticResource Visible}}"
                           TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding DataContext.TextEvidence, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="12" Foreground="{StaticResource Muted}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Evidence}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding StringFormat='· {0}'}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontFamily="Consolas" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Id}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0" FontFamily="Consolas" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>

    <!-- Header: product, promise, language -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Green}" Padding="28,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Visibility="{Binding TechnicianMode, Converter={StaticResource Visible}}" Background="{StaticResource Amber}" CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
            <TextBlock Text="{Binding TextTechnicianMode}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
          </Border>
          <Border Visibility="{Binding ShowReadOnlyBadge, Converter={StaticResource Visible}}" Background="{StaticResource GreenDark}" CornerRadius="12" Padding="10,4" Margin="0,0,16,0">
            <TextBlock Text="{Binding TextReadOnlyBadge}" Foreground="White" FontSize="12" />
          </Border>
          <TextBlock Text="{Binding TextLanguage}" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name"
                    MinWidth="120" AutomationProperties.Name="{Binding TextLanguage}" />
        </StackPanel>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Grid Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
              <Ellipse Fill="White" />
              <Path Data="M 10,17 L 15,22 L 24,12" Stroke="{StaticResource Green}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Grid>
            <StackPanel>
              <TextBlock Text="Shiva Assist" Foreground="White" FontSize="21" FontWeight="SemiBold" />
              <TextBlock Text="{Binding TextTagline}" Foreground="#E3F5E9" FontSize="12.5" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Footer: status, help -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="{Binding TextHelp}" Command="{Binding HelpCommand}" />
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Menu: one entry per module (blueprint: twelve modules); a dot shows the worst result, "Soon" marks later phases -->
    <Border DockPanel.Dock="Left" Width="230" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Modules}" Margin="10,14" KeyboardNavigation.TabNavigation="Continue">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                      Cursor="Hand" Margin="0,0,0,2" AutomationProperties.Name="{Binding Name}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="12,9">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" x:Name="Icon" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center"
                                 Visibility="{Binding HasDot, Converter={StaticResource Visible}}" />
                        <Border DockPanel.Dock="Right" Background="{StaticResource Page}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center"
                                Visibility="{Binding IsSoon, Converter={StaticResource Visible}}">
                          <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Muted}" />
                        </Border>
                        <TextBlock x:Name="Label" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{StaticResource GreenSoft}" />
                      </Trigger>
                      <DataTrigger Binding="{Binding Selected}" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{StaticResource Green}" />
                        <Setter TargetName="Label" Property="Foreground" Value="White" />
                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="Icon" Property="Foreground" Value="White" />
                      </DataTrigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Ink}" />
                        <Setter TargetName="Row" Property="BorderThickness" Value="1" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Grid>

    <!-- Overview page: persistent scan setup and active scan progress. -->
    <Grid Margin="28,22" Visibility="{Binding IsOverviewPage, Converter={StaticResource Visible}}">

      <!-- 1. Ready: welcome, the big round button, and the areas the check-up covers -->
      <ScrollViewer Visibility="{Binding IsReady, Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="{Binding TextIntroTitle}" FontSize="27" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource GreenDark}" />
          <TextBlock Text="{Binding TextIntro}" FontSize="14.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,18" LineHeight="21" />
          <Button Style="{StaticResource ScanButton}" Command="{Binding StartScanCommand}" HorizontalAlignment="Center" AutomationProperties.Name="{Binding TextStart}">
            <TextBlock Text="{Binding TextStart}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="130" />
          </Button>
          <TextBlock Text="{Binding TextDuration}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,20" />

          <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="22,16">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource AreaCheck}" Content="{Binding TextSelectAll}" IsChecked="{Binding AllAreasSelected}" FontSize="13" />
                <TextBlock Text="{Binding TextAreasTitle}" FontWeight="SemiBold" Foreground="{StaticResource GreenDark}" VerticalAlignment="Center" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding ScanAreas}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Style="{StaticResource AreaCheck}" IsChecked="{Binding IsChecked}" Margin="0,6,12,6" AutomationProperties.Name="{Binding Name}">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Visibility="{Binding ShowAdminHint, Converter={StaticResource Visible}}" Background="{StaticResource GreenSoft}" CornerRadius="12" Padding="16,10" Margin="0,14,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="{Binding TextRestartAsAdmin}" Command="{Binding RestartAsAdminCommand}" />
              <TextBlock Text="{Binding TextAdminHint}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- 2. Scanning -->
      <StackPanel Visibility="{Binding IsScanning, Converter={StaticResource Visible}}" MaxWidth="520" VerticalAlignment="Center">
        <TextBlock Text="{Binding TextScanning}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GreenDark}" />
        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="{Binding ProgressMax}" Height="12" Margin="0,16,0,8"
                     Foreground="{StaticResource Green}" Background="{StaticResource GreenSoft}" BorderThickness="0" />
        <TextBlock Text="{Binding TextProgress}" Foreground="{StaticResource Muted}" />
      </StackPanel>

    </Grid>

    <Grid Margin="28,22" Visibility="{Binding IsResultsPage, Converter={StaticResource Visible}}">
      <StackPanel Visibility="{Binding ResultsEmpty, Converter={StaticResource Visible}}" VerticalAlignment="Center">
        <TextBlock Text="{Binding TextResultsEmpty}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,16" />
        <Button Content="{Binding TextStart}" Command="{Binding ConfigureScanCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" />
      </StackPanel>
      <DockPanel Visibility="{Binding HasResults, Converter={StaticResource Visible}}">

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Style="{StaticResource QuietButton}" Content="{Binding TextSave}" Command="{Binding SaveReportCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="{Binding TextScanAgain}" Command="{Binding ConfigureScanCommand}" Padding="16,7" FontSize="13" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Binding TextHeadline}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource GreenDark}" />
            <TextBlock Text="{Binding TextSummary}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding TextSystem}" Foreground="{StaticResource Muted}" FontSize="12" />
          </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" Visibility="{Binding ShowRepairReview, Converter={StaticResource Visible}}"
                Background="{StaticResource GreenSoft}" CornerRadius="12" Padding="14" Margin="0,0,0,14">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{Binding TextReviewRepairs}" Command="{Binding ReviewRepairsCommand}"
                      Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" />
              <TextBlock Text="{Binding TextRepairCoverage}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <Button Content="{Binding TextRestartAsAdmin}" Command="{Binding RestartAsAdminCommand}"
                    Visibility="{Binding ShowAdminHint, Converter={StaticResource Visible}}"
                    Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <!-- Module tiles: worst severity colours the bar; click to open the module page -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding ModuleTiles}" Margin="0,0,0,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                      Margin="0,0,10,10" Cursor="Hand" AutomationProperties.Name="{Binding Name}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Tile" Width="176" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="0">
                      <StackPanel>
                        <Border Height="8" Background="{Binding Accent}" CornerRadius="12,12,0,0" />
                        <StackPanel Margin="14,10,14,12">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                          <TextBlock Text="{Binding Status}" Foreground="{Binding Accent}" FontSize="13" Margin="0,2,0,0" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Tile" Property="Background" Value="{StaticResource GreenSoft}" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Ink}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <CheckBox Content="{Binding TextShowHealthy}" IsChecked="{Binding ShowHealthy}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Findings: layer 1 always, layers 2-3 under Details -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingCard}" />
        </ScrollViewer>
      </DockPanel>

    </Grid>

    <!-- Module page: what the module covers and its findings -->
    <DockPanel Margin="28,22" Visibility="{Binding IsModulePage, Converter={StaticResource Visible}}">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding TextStart}" Command="{Binding StartScanCommand}"
                VerticalAlignment="Top" Padding="16,7" FontSize="13" />
        <Grid DockPanel.Dock="Left" Width="46" Height="46" Margin="0,0,14,0" VerticalAlignment="Top">
          <Ellipse Fill="{StaticResource GreenSoft}" />
          <TextBlock Text="{Binding SelectedModule.Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                     Foreground="{StaticResource GreenDark}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <StackPanel>
          <TextBlock Text="{Binding SelectedModule.Name}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource GreenDark}" />
          <TextBlock Text="{Binding SelectedModule.Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,16,0" />
        </StackPanel>
      </DockPanel>
      <Border DockPanel.Dock="Top" Visibility="{Binding ModuleNeedsScan, Converter={StaticResource Visible}}"
              Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="20,16">
        <TextBlock Text="{Binding TextModuleNeedsScan}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ModuleHasResults, Converter={StaticResource Visible}}">
        <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingCard}" />
      </ScrollViewer>
    </DockPanel>

    <DockPanel Margin="28,22" Visibility="{Binding IsSoftwarePage, Converter={StaticResource Visible}}">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
        <TextBlock Text="{Binding SelectedModule.Name}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource GreenDark}" />
        <TextBlock Text="{Binding Software.TextScope}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{Binding Software.TextRefresh}" Command="{Binding Software.RefreshCommand}"
                  Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" />
          <StackPanel>
            <TextBlock Text="{Binding Software.TextSearch}" Margin="0,0,0,4" />
            <TextBox Text="{Binding Software.Search, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
          </StackPanel>
        </DockPanel>
        <TextBlock Text="{Binding Software.Status}" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <Expander Header="{Binding Software.TextCheckUpdates}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="{Binding Software.TextUpdateScope}" TextWrapping="Wrap" Margin="0,8" />
            <StackPanel Orientation="Horizontal">
              <Button Content="{Binding Software.TextCheckUpdates}" Command="{Binding Software.CheckUpdatesCommand}" Style="{StaticResource PrimaryButton}" />
              <Button Content="{Binding Software.TextUpdateSelected}" Command="{Binding Software.UpdateCommand}" Margin="8,0,0,0"
                      Visibility="{Binding Software.ShowUpdateAction, Converter={StaticResource Visible}}" />
            </StackPanel>
            <TextBlock Text="{Binding Software.UpdateStatus}" TextWrapping="Wrap" Margin="0,8" AutomationProperties.LiveSetting="Polite" />
            <DataGrid ItemsSource="{Binding Software.Updates}" SelectedItem="{Binding Software.SelectedUpdate}" MaxHeight="190"
                      SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0">
              <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Name}" Width="2*">
                  <DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{Binding DataContext.Software.TextName, RelativeSource={RelativeSource AncestorType=DataGrid}}" /></DataTemplate></DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*" />
                <DataGridTextColumn Binding="{Binding InstalledVersion}" Width="*">
                  <DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{Binding DataContext.Software.TextVersion, RelativeSource={RelativeSource AncestorType=DataGrid}}" /></DataTemplate></DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding AvailableVersion}" Width="*">
                  <DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{Binding DataContext.Software.TextAvailableVersion, RelativeSource={RelativeSource AncestorType=DataGrid}}" /></DataTemplate></DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Expander>
      </StackPanel>
      <DataGrid ItemsSource="{Binding Software.Items}" AutoGenerateColumns="False" IsReadOnly="True"
                CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                EnableRowVirtualization="True" GridLinesVisibility="Horizontal" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" RowHeaderWidth="0">
        <DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Name}" Width="2*" MinWidth="150">
            <DataGridTextColumn.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DataContext.Software.TextName, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
              </DataTemplate>
            </DataGridTextColumn.HeaderTemplate>
          </DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding Publisher}" Width="*" MinWidth="100">
            <DataGridTextColumn.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DataContext.Software.TextPublisher, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
              </DataTemplate>
            </DataGridTextColumn.HeaderTemplate>
          </DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding Version}" Width="*" MinWidth="80">
            <DataGridTextColumn.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DataContext.Software.TextVersion, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
              </DataTemplate>
            </DataGridTextColumn.HeaderTemplate>
          </DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding Size}" Width="Auto">
            <DataGridTextColumn.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DataContext.Software.TextSize, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
              </DataTemplate>
            </DataGridTextColumn.HeaderTemplate>
          </DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding Date}" Width="Auto">
            <DataGridTextColumn.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DataContext.Software.TextDate, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
              </DataTemplate>
            </DataGridTextColumn.HeaderTemplate>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <!-- History and undo: every repair from the audit log, with undo where the old state was recorded -->
    <DockPanel Margin="28,22" Visibility="{Binding IsHistoryPage, Converter={StaticResource Visible}}">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
        <Grid DockPanel.Dock="Left" Width="46" Height="46" Margin="0,0,14,0" VerticalAlignment="Top">
          <Ellipse Fill="{StaticResource GreenSoft}" />
          <TextBlock Text="{Binding SelectedModule.Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                     Foreground="{StaticResource GreenDark}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <StackPanel>
          <TextBlock Text="{Binding SelectedModule.Name}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource GreenDark}" />
          <TextBlock Text="{Binding SelectedModule.Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,16,0" />
        </StackPanel>
      </DockPanel>
      <Border DockPanel.Dock="Top" Visibility="{Binding HistoryEmpty, Converter={StaticResource Visible}}"
              Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="20,16">
        <TextBlock Text="{Binding TextHistoryEmpty}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding History}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,10">
                <DockPanel>
                  <Border DockPanel.Dock="Left" Width="6" Background="{Binding Colour}" CornerRadius="12,0,0,12" />
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Style="{StaticResource QuietButton}" Content="{Binding DataContext.TextUndo, RelativeSource={RelativeSource AncestorType=Window}}"
                            Command="{Binding UndoCommand}" Visibility="{Binding CanUndo, Converter={StaticResource Visible}}" Padding="14,6" />
                    <Button Style="{StaticResource QuietButton}" Content="{Binding DataContext.TextOpenSystemRestore, RelativeSource={RelativeSource AncestorType=Window}}"
                            Command="{Binding OpenRestoreCommand}" Visibility="{Binding HasRestorePoint, Converter={StaticResource Visible}}"
                            ToolTip="{Binding DataContext.TextRestorePointHint, RelativeSource={RelativeSource AncestorType=Window}}" Padding="14,6" Margin="8,0,0,0" />
                  </StackPanel>
                  <StackPanel Margin="16,12,16,12">
                    <TextBlock Text="{Binding When}" FontSize="12" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Outcome}" Foreground="{Binding Colour}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- "Soon" page for modules of a later phase -->
    <StackPanel Margin="28,22" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                Visibility="{Binding IsSoonPage, Converter={StaticResource Visible}}">
      <Grid Width="96" Height="96" HorizontalAlignment="Center">
        <Ellipse Fill="{StaticResource GreenSoft}" />
        <TextBlock Text="{Binding SelectedModule.Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="38"
                   Foreground="{StaticResource GreenDark}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Text="{Binding SelectedModule.Name}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource GreenDark}"
                 HorizontalAlignment="Center" Margin="0,16,0,6" />
      <TextBlock Text="{Binding SelectedModule.Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="21" />
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="18,12" Margin="0,18,0,0">
        <TextBlock Text="{Binding TextSoon}" TextWrapping="Wrap" TextAlignment="Center" />
      </Border>
    </StackPanel>

    </Grid>
  </DockPanel>
</Window>
