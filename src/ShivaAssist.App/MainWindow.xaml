<Window x:Class="ShivaAssist.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Product}" Width="1060" Height="780" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Page}"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Navy}">
  <DockPanel>

    <!-- Header: product, promise, language -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Navy}" Padding="28,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#1E3A5F" CornerRadius="12" Padding="10,4" Margin="0,0,16,0">
            <TextBlock Text="{Binding TextReadOnlyBadge}" Foreground="#CFE0FF" FontSize="12" />
          </Border>
          <TextBlock Text="{Binding TextLanguage}" Foreground="#CFE0FF" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name"
                    MinWidth="120" AutomationProperties.Name="{Binding TextLanguage}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Shiva Assist" Foreground="White" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="{Binding TextTagline}" Foreground="#CFE0FF" FontSize="13" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Footer: status, help -->
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="{Binding TextHelp}" Command="{Binding HelpCommand}" />
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid Margin="28,22">

      <!-- 1. Ready -->
      <StackPanel Visibility="{Binding IsReady, Converter={StaticResource Visible}}" MaxWidth="620" VerticalAlignment="Center">
        <TextBlock Text="{Binding TextIntroTitle}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding TextIntro}" FontSize="15" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,24" LineHeight="22" />
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource PrimaryButton}" Content="{Binding TextStart}" Command="{Binding StartScanCommand}" />
          <TextBlock Text="{Binding TextDuration}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>
        <Border Visibility="{Binding ShowAdminHint, Converter={StaticResource Visible}}" Background="{StaticResource LightBlue}" CornerRadius="8" Padding="14,10" Margin="0,24,0,0">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="{Binding TextRestartAsAdmin}" Command="{Binding RestartAsAdminCommand}" />
            <TextBlock Text="{Binding TextAdminHint}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
          </DockPanel>
        </Border>
      </StackPanel>

      <!-- 2. Scanning -->
      <StackPanel Visibility="{Binding IsScanning, Converter={StaticResource Visible}}" MaxWidth="520" VerticalAlignment="Center">
        <TextBlock Text="{Binding TextScanning}" FontSize="22" FontWeight="SemiBold" />
        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="{Binding ProgressMax}" Height="10" Margin="0,16,0,8"
                     Foreground="{StaticResource Blue}" Background="{StaticResource LightBlue}" BorderThickness="0" />
        <TextBlock Text="{Binding TextProgress}" Foreground="{StaticResource Muted}" />
      </StackPanel>

      <!-- 3. Results -->
      <DockPanel Visibility="{Binding HasResults, Converter={StaticResource Visible}}">

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Style="{StaticResource QuietButton}" Content="{Binding TextSave}" Command="{Binding SaveReportCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="{Binding TextStart}" Command="{Binding StartScanCommand}" Padding="16,7" FontSize="13" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Binding TextHeadline}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding TextSummary}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding TextSystem}" Foreground="{StaticResource Muted}" FontSize="12" />
          </StackPanel>
        </DockPanel>

        <!-- Category tiles: worst severity colours the bar; click to filter -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Tiles}" Margin="0,0,0,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding DataContext.SelectTileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                      Margin="0,0,10,10" Cursor="Hand" AutomationProperties.Name="{Binding Name}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Tile" Width="176" Background="White" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="10" Padding="0">
                      <StackPanel>
                        <Border Height="5" Background="{Binding Accent}" CornerRadius="10,10,0,0" />
                        <StackPanel Margin="14,10,14,12">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Status}" Foreground="{Binding Accent}" FontSize="13" Margin="0,2,0,0" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <DataTrigger Binding="{Binding Selected}" Value="True">
                        <Setter TargetName="Tile" Property="BorderBrush" Value="#1465DF" />
                        <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                      </DataTrigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Tile" Property="Background" Value="#EFF6FF" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Tile" Property="BorderBrush" Value="#10233E" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <CheckBox Content="{Binding TextShowHealthy}" IsChecked="{Binding ShowHealthy}" VerticalAlignment="Center" />
          <Button Style="{StaticResource QuietButton}" Content="{Binding TextAllCategories}" Command="{Binding SelectTileCommand}"
                  HorizontalAlignment="Right" Padding="10,4" FontSize="12" />
        </DockPanel>

        <!-- Findings: layer 1 always, layers 2-3 under Details -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Findings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="White" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="5" Background="{Binding Accent}" CornerRadius="10,0,0,10" />
                    <StackPanel Margin="16,12,16,12">
                      <DockPanel>
                        <Border DockPanel.Dock="Left" Background="{Binding Soft}" CornerRadius="10" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Top">
                          <TextBlock Text="{Binding Badge}" Foreground="{Binding Accent}" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                      </DockPanel>
                      <TextBlock Text="{Binding Advice, StringFormat='→ {0}'}" Visibility="{Binding HasAdvice, Converter={StaticResource Visible}}"
                                 TextWrapping="Wrap" Margin="0,8,0,0" />
                      <Expander IsExpanded="{Binding Expanded}" Margin="0,8,0,0" Foreground="{StaticResource Blue}"
                                Header="{Binding DataContext.TextDetails, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Margin="20,6,0,0">
                          <TextBlock Text="{Binding Cause}" Visibility="{Binding HasCause, Converter={StaticResource Visible}}"
                                     TextWrapping="Wrap" Foreground="{StaticResource Navy}" Margin="0,0,0,8" />
                          <TextBlock Text="{Binding DataContext.TextEvidence, RelativeSource={RelativeSource AncestorType=Window}}"
                                     FontSize="12" Foreground="{StaticResource Muted}" FontWeight="SemiBold" />
                          <ItemsControl ItemsSource="{Binding Evidence}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='· {0}'}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontFamily="Consolas" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Text="{Binding Id}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0" FontFamily="Consolas" />
                        </StackPanel>
                      </Expander>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

    </Grid>
  </DockPanel>
</Window>
