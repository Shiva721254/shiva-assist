<Application x:Class="ShivaAssist.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Bright palette: solid green on cream. Keep in sync with ViewModels/Palette.cs. -->
    <SolidColorBrush x:Key="Ink" Color="#2F3B33" />
    <SolidColorBrush x:Key="Green" Color="#2E9E5B" />
    <SolidColorBrush x:Key="GreenDark" Color="#1F7A44" />
    <SolidColorBrush x:Key="GreenSoft" Color="#DDF3E4" />
    <SolidColorBrush x:Key="Page" Color="#FBF7EE" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Line" Color="#E8E0CF" />
    <SolidColorBrush x:Key="Muted" Color="#6E6A5E" />
    <SolidColorBrush x:Key="Amber" Color="#E8890C" />
    <BooleanToVisibilityConverter x:Key="Visible" />

    <SolidColorBrush x:Key="GreenPressed" Color="#17633A" />
    <SolidColorBrush x:Key="Disabled" Color="#D9D3C5" />
    <SolidColorBrush x:Key="DisabledText" Color="#8A8577" />

    <!-- Main action: large, solid green, clear hover/pressed/disabled states (minimum 46 px high for easy clicking) -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Green}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="24,12" />
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource GreenDark}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource GreenPressed}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ink}" />
                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Disabled}" />
                <Setter Property="Foreground" Value="{StaticResource DisabledText}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Fix it all: the biggest button in the app, with a soft shadow so it reads as the one thing to press -->
    <Style x:Key="HeroButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="32,14" />
      <Setter Property="MinHeight" Value="76" />
      <Setter Property="MinWidth" Value="270" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
              <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" Color="#1F7A44" />
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource GreenDark}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource GreenPressed}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ink}" />
                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Disabled}" />
                <Setter TargetName="Box" Property="Effect" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{StaticResource DisabledText}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuietButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="Foreground" Value="{StaticResource GreenDark}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="#BFDCC9" BorderThickness="1.5" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource GreenSoft}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#C8EBD3" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Green}" />
                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledText}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The big round check-up button on the start screen -->
    <Style x:Key="ScanButton" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Width="220" Height="220">
              <Ellipse Fill="{StaticResource GreenSoft}" />
              <Ellipse x:Name="Ring" Margin="12" Stroke="#A9DDBB" StrokeThickness="3" />
              <Ellipse x:Name="Face" Margin="26" Fill="{StaticResource Green}">
                <Ellipse.Effect>
                  <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.22" Color="#1F7A44" />
                </Ellipse.Effect>
              </Ellipse>
              <ContentPresenter Margin="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="TextAlignment" Value="Center" />
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Fill" Value="{StaticResource GreenDark}" />
                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Green}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Ink}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Rounded green check box for the check-up areas -->
    <Style x:Key="AreaCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="20" Height="20" CornerRadius="5" BorderThickness="1.5"
                      BorderBrush="#9BCFAE" Background="{StaticResource Surface}" VerticalAlignment="Center">
                <Path x:Name="Tick" Data="M 4,10 L 8,14 L 16,5" Stroke="White" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Green}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Green}" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GreenDark}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ink}" />
                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
