<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NU1900 = vulnerability feed unreachable (offline build); a real vulnerability (NU1901-NU1904) still fails the build -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Real culture data: Dutch and later languages format numbers their own way (7,0 GB) -->
    <InvariantGlobalization>false</InvariantGlobalization>
    
    <Version>0.1.7</Version>
    <Company>Shiva Computers</Company>
    <Product>Shiva Assist</Product>
    <Copyright>© Shiva Computers</Copyright>
    <!-- CA1716: "Module" is the finding-contract field name; the VB keyword clash does not matter here -->
    <NoWarn>$(NoWarn);CA2007;CA1303;CA1848;CA1515;CA1716</NoWarn>
  </PropertyGroup>
</Project>
